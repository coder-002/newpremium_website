# Gmail account that sends the contact-form emails
GMAIL_USER=yourname@gmail.com
# 16-character Google App Password (Google Account → Security → 2-Step Verification → App passwords)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Optional: where requests are delivered (defaults to GMAIL_USER)
CONTACT_TO=
# Optional: Google Analytics 4 Measurement ID (leave empty to disable tracking)
NEXT_PUBLIC_GA_ID=
# Public site URL used for metadata (canonical/OG links)
NEXT_PUBLIC_SITE_URL=https://premiumtech.com.np
# Docker only: host port the container is exposed on
HOST_PORT=3000
